<?xml version="1.0" encoding="utf-8"?>
<!-- Detaljsida i modernt utseende: bakgrundsbild över hela skärmen, tonad mot svart. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/m_scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/m_scrim_bottom" />

    <ImageView
        android:id="@+id/poster"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="60dp"
        android:paddingEnd="64dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/m_text"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/m_text2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/plot"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="5"
            android:textColor="@color/m_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/people"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/m_text2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/play_resume"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/m_button"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:textAllCaps="false"
                android:textColor="@color/m_on_focus"
                android:textSize="17sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/play"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/m_button"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:textAllCaps="false"
                android:textColor="@color/m_on_focus"
                android:textSize="17sp"
                android:text="▶  Spela" />

            <Button
                android:id="@+id/favorite"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/m_button"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:textAllCaps="false"
                android:textColor="@color/m_on_focus"
                android:textSize="17sp" />

            <Button
                android:id="@+id/record"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/m_button"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="⬇  Spela in"
                android:textAllCaps="false"
                android:textColor="@color/m_on_focus"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/m_text2"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/more_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Mer som detta"
            android:textColor="@color/m_text"
            android:textSize="18sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</FrameLayout>
