<?xml version="1.0" encoding="utf-8"?>
<!-- Stående (telefonen i mobilläge). TV-boxarna använder alltid den liggande varianten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="112dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/m_card_bg"
    android:focusable="true"
    android:foreground="@drawable/m_card_focus"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/m_logo_tile">

        <TextView
            android:id="@+id/fallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/m_text2"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/m_text"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/m_progress"
        android:visibility="invisible" />
</LinearLayout>
