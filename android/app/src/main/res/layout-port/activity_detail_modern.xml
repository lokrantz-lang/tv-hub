<?xml version="1.0" encoding="utf-8"?>
<!-- Stående detaljsida (telefonen): bild överst, sedan text och knappar som går att scrolla. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp">

            <ImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/m_scrim_bottom" />

            <ImageView
                android:id="@+id/poster"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="3"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/m_text"
                android:textSize="26sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/m_text2"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/play_resume"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/m_button_primary"
                    android:textAllCaps="false"
                    android:textColor="#0A0A0C"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/play"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/m_button"
                    android:text="▶  Spela"
                    android:textAllCaps="false"
                    android:textColor="@color/m_on_focus"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/favorite"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/m_button"
                    android:textAllCaps="false"
                    android:textColor="@color/m_on_focus"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttons2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/rate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/m_button"
                    android:text="Betygsätt"
                    android:textAllCaps="false"
                    android:textColor="@color/m_on_focus"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/wish"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/m_button"
                    android:text="☆  Vill se"
                    android:textAllCaps="false"
                    android:textColor="@color/m_on_focus"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/versions"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/m_button"
                    android:text="Versioner"
                    android:textAllCaps="false"
                    android:textColor="@color/m_on_focus"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/play_on_tv"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/m_button"
                    android:text="📺  TV"
                    android:textAllCaps="false"
                    android:textColor="@color/m_on_focus"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/m_text2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/m_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/people"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/m_text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/more_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Mer som detta"
                android:textColor="@color/m_text"
                android:textSize="17sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
